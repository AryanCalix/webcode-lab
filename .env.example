# Frontend — publishable values only. Never put a service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local-only, used by `npm run seed:auth` (do not expose to the browser).
# Copy to .env.seed and fill in from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_STUDENT_PASSWORD=budi1234
DEMO_LECTURER_PASSWORD=siti1234

# Edge Function secret (set with `npx supabase secrets set`):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# CORS allow-list for Edge Functions. Pisahkan dengan koma.
# Untuk production, tambahkan domain Vercel: https://<nama-app>.vercel.app
# ALLOWED_ORIGINS=http://localhost:5173

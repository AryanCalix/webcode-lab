{
  "name": "webcode-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "seed:auth": "node --env-file-if-exists=.env.seed scripts/seed-auth.mjs",
    "create:lecturer": "node --env-file-if-exists=.env.seed scripts/create-lecturer.mjs",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "functions:serve": "supabase functions serve"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.69.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
